# =====================================================================
# VITRINE — variables d'environnement (exemple, AUCUNE vraie clé ici)
# =====================================================================

# ---- Application mobile (fichier .env à la racine) -------------------
# Ces deux valeurs sont PUBLIQUES par nature (la sécurité repose sur la RLS).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Serveur : secrets des Edge Functions -----------------------------
# À définir avec : supabase secrets set NOM=valeur   (JAMAIS dans l'app)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=            # facultatif : configuration « Facebook Login for Business »
# META_GRAPH_VERSION=v23.0
# TOKEN_ENCRYPTION_KEY=      # openssl rand -base64 32
# PUBLIC_SITE_URL=https://vitrine.example
# (Phase 2) STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET=
# (Monitoring) SENTRY_DSN=
