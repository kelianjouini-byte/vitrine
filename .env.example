# =====================================================================
# VITRINE — variables d'environnement (exemple, AUCUNE vraie clé ici)
# =====================================================================

# ---- Application mobile (fichier .env à la racine) -------------------
# Ces deux valeurs sont PUBLIQUES par nature (la sécurité repose sur la RLS).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Serveur : secrets des Edge Functions -----------------------------
# À définir avec : supabase secrets set NOM=valeur   (JAMAIS dans l'app)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# --- OU un fournisseur « compatible OpenAI » (ex. offre gratuite pour tester) :
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Google Gemini
# AI_API_KEY=
# AI_MODEL=
# AI_JSON_MODE=object        # si le fournisseur refuse json_schema
# GROQ_API_KEY=              # facultatif, gratuit (console.groq.com) : IA essayée en premier, très rapide
# GROQ_MODEL=qwen/qwen3.8-27b  # modèle Groq qui sait lire les photos
# AI_FALLBACK_MODEL=         # modèle de secours, lancé si le premier est saturé ou lent (Gemini : gemini-3.5-flash-lite par défaut)
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=            # facultatif : configuration « Facebook Login for Business »
# META_GRAPH_VERSION=v23.0
# TOKEN_ENCRYPTION_KEY=      # openssl rand -base64 32 (jetons Meta + codes des employés)
# PUBLIC_SITE_URL=https://vitrineappli.fr
# PUBLIC_APP_URL=https://vitrineappli.fr/   # facultatif : retour de la connexion Meta (version web)
# ---- Paiement (Stripe) : abonnements Mensuel 39 € / Annuel 29 € par mois, 1er mois offert
# STRIPE_SECRET_KEY=         # Stripe > Développeurs > Clés API > « Clé secrète » (sk_test_… pour tester, sk_live_… en vrai)
# STRIPE_WEBHOOK_SECRET=     # Stripe > Développeurs > Webhooks > l'adresse …/functions/v1/stripe-webhook > « Clé secrète de signature » (whsec_…)
# Le produit « Vitrine », les deux prix et les réglages du portail client sont créés automatiquement par le serveur.
# (Monitoring) SENTRY_DSN=
