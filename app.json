{
  "expo": {
    "name": "Vitrine",
    "slug": "vitrine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.vitrine.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F7658",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.vitrine.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Vitrine",
      "themeColor": "#2F7658",
      "backgroundColor": "#2F7658"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vitrine utilise l'appareil photo pour photographier vos produits.",
          "photosPermission": "Vitrine accède à vos photos pour préparer vos publications."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#2F7658",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "scheme": "vitrine",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
